# Environment variables template
# Copy this to .env and fill in your values

# Reddit API (for data collection)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=sentiment_analysis_bot/1.0

# Kaggle API (for dataset download)
# Place kaggle.json in ~/.kaggle/ directory instead

# DagsHub (for MLflow tracking)
DAGSHUB_USER=your_dagshub_username
DAGSHUB_REPO=mlops-sentiment-analysis
DAGSHUB_TOKEN=your_dagshub_token

# Model settings
MODEL_PATH=models/best_distilbert_model.pth
MODEL_TYPE=distilbert

# Kafka settings
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sentiment-predictions

# Database
DATABASE_URL=sqlite:///./sentiment_predictions.db
# For PostgreSQL: postgresql://user:password@localhost:5432/dbname

# API settings
API_HOST=0.0.0.0
API_PORT=8000

# Fly.io (for deployment)
FLY_API_TOKEN=your_fly_api_token
