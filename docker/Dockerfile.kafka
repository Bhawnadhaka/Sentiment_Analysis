# Kafka Consumer Docker Image
FROM python:3.10-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/

# Set Python path
ENV PYTHONPATH=/app

# Run Kafka consumer
CMD ["python", "-m", "src.api.kafka_consumer"]
